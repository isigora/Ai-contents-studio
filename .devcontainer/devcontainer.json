{
  "name": "Content Studio P0 + P1",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "node",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": { "label": "Content Studio", "onAutoForward": "notify", "protocol": "http" }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && node scripts/setup-codespaces.mjs",
  "postStartCommand": "bash scripts/start-codespaces.sh",
  "waitFor": "postCreateCommand",
  "customizations": { "vscode": { "settings": { "remote.autoForwardPorts": true } } }
}
