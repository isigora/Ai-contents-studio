# Generate a random secret, never commit the actual value.
APP_MODE=local
APP_URL=http://localhost:4173
TRUSTED_ORIGINS=http://localhost:4173
BETTER_AUTH_SECRET=
# With APP_MODE=local only, omission uses persistent server-side PGlite.
DATABASE_URL=
DB_AUTO_MIGRATE=false
LOCAL_DATA_DIR=.data
# Required for production. The bucket must be private.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Explicit cost approval and approved server model configuration are required.
AI_ENABLED=false
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
AI_RUN_RESERVATION_USD=0.10
AI_DAILY_LIMIT_USD=2

# P1 media. Defaults use bundled Noto CJK font and ffmpeg on PATH.
MEDIA_FONT_PATH=
FFMPEG_PATH=
